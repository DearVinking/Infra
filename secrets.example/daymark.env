# environment: daymark —— 签到仓库的 secrets

# 私有签到仓库 owner/repo，作为 secret 存放以便 GitHub 在日志中打码
SOURCE_REPOSITORY=

# 余额历史与浏览器 Profile 状态缓存的加密口令。留空则由 scripts/setup.sh 自动生成并回写到这里，请妥善备份
ENCRYPTION_PASSPHRASE=

# 账号配置（JSON 数组，单行）
ACCOUNTS=

# 可选：平台配置 JSON
PROVIDERS=

# 可选：Clash / Mihomo 订阅链接，配置后签到前会先启动本地代理
PROXY_SUBSCRIPTION_URL=

# 通知
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_METHOD=
CUSTOM_WEBHOOK_HEADERS=
CUSTOM_WEBHOOK_BODY_TEMPLATE=
WEBHOOK_URL=
