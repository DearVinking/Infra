# environment: astrionyx —— 对应原 DearVinking/Astrionyx 仓库的 secrets

# 阿里云容器镜像服务
ACR_REGISTRY=
ACR_NAMESPACE=
ACR_REPO=
ACR_USERNAME=
ACR_PASSWORD=

# 部署服务器 SSH（KEY 为私钥文件，可用 @ 指向文件）
HOST=
USER=
PORT=
KEY=@.secrets/astrionyx-ssh.key

# 可选：服务器 known_hosts 内容（ssh-keyscan -p <PORT> <HOST>），配置后严格校验主机指纹
SSH_KNOWN_HOSTS=
