# environment: yohaku —— 对应原 DearVinking/Yohaku 仓库的 secrets / variables

# 阿里云容器镜像服务
ACR_REGISTRY=
ACR_NAMESPACE=
ACR_REPO=
ACR_USERNAME=
ACR_PASSWORD=

# 构建参数（BASE_URL 对应原仓库的 variable BASE_URL，API_URL 对应原 secret API_URL）
BASE_URL=
API_URL=

# 部署服务器 SSH（KEY 为私钥文件，可用 @ 指向文件）
HOST=
USER=
PORT=
KEY=@.secrets/yohaku-ssh.key

# 可选：服务器 known_hosts 内容（ssh-keyscan -p <PORT> <HOST>），配置后严格校验主机指纹
SSH_KNOWN_HOSTS=

# 可选：读取上游 innei-dev/yohaku 的 token，留空则使用 CI_TOKEN
UPSTREAM_TOKEN=
